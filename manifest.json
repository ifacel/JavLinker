{
  "manifest_version": 3,
  "name": "Jav Linker",
  "description": "连接看片网站",
  "action": {
    "default_popup": "src/popup/settings.html"
  },
  "content_scripts": [
    {
      "js": ["src/content.ts"],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "permissions": ["cookies", "storage", "tabs","webRequest","declarativeNetRequest","declarativeNetRequestFeedback"],
  "host_permissions": ["https://*/"],
  "background": {
    "scripts": ["src/background.js"],
    "service_worker": "src/background.js",
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "veckdev@gmail.com"
    }
  }
}
